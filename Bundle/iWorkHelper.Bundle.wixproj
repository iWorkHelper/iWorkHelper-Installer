<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <OutputName>iWorkHelper-Setup-$(InstallerVersion)-x64</OutputName>
    <BARoot>$(MSBuildThisFileDirectory)..\BootstrapperApplication\bin\Release\net462</BARoot>
    <DefineConstants>$(DefineConstants);InstallerVersion=$(InstallerVersion);InstallerManufacturer=$(InstallerManufacturer);ArtifactsRoot=$(ArtifactsRoot);PayloadRoot=$(PayloadRoot);BARoot=$(BARoot)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
    <ProjectReference Include="..\MSI\iWorkHelper.Msi.wixproj" />
    <ProjectReference Include="..\BootstrapperApplication\iWorkHelper.BootstrapperApplication.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="iWorkHelper"
           ProductCode="$(InstallerProductCode)"
           Manufacturer="$(InstallerManufacturer)"
           Version="$(InstallerVersion)"
           UpgradeCode="{A8F80F1A-7323-4C14-ACD0-281A333CDA33}"
           Scope="perUserOrMachine"
           Language="!(loc.ProductLanguage)"
           Codepage="!(loc.ProductCodepage)">
    <SummaryInformation Description="!(loc.ProductDescription)" Manufacturer="$(InstallerManufacturer)" />
    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="MSIDEPLOYMENTCOMPLIANT" Value="1" />
    <Property Id="ARPSYSTEMCOMPONENT" Value="1" />
    <!-- Development builds require an independent verbose MSI log even for
         client-side per-user execution where Burn may not create one. -->
    <Property Id="MsiLogging" Value="voicewarmupx!" />
    <Property Id="IWORKHELPER_REQUESTEDSCOPE" Value="Unknown" Secure="yes" />
    <Property Id="IWORKHELPER_BUNDLEPLANNEDSCOPE" Value="0" Secure="yes" />
    <Property Id="IWORKHELPER_BUNDLEELEVATED" Value="0" Secure="yes" />
    <Property Id="IWORKHELPER_INSTALLCONTEXT" Value="Unknown" Secure="yes" />

    <CustomAction Id="SetPerUserInstallFolder" Property="INSTALLFOLDER"
                  Value="[LocalAppDataFolder]Programs\iWorkHelper" Execute="firstSequence" />
    <CustomAction Id="SetPerMachineInstallFolder" Property="INSTALLFOLDER"
                  Value="[ProgramFiles64Folder]iWorkHelper" Execute="firstSequence" />
    <CustomAction Id="SetArpInstallLocation" Property="ARPINSTALLLOCATION"
                  Value="[INSTALLFOLDER]" Execute="firstSequence" />
    <CustomAction Id="SetPerUserDiagnosticContext" Property="IWORKHELPER_INSTALLCONTEXT"
                  Value="PerUser; ALLUSERS=[ALLUSERS]; MSIINSTALLPERUSER=[MSIINSTALLPERUSER]; INSTALLFOLDER=[INSTALLFOLDER]" Execute="firstSequence" />
    <CustomAction Id="SetPerMachineDiagnosticContext" Property="IWORKHELPER_INSTALLCONTEXT"
                  Value="PerMachine; ALLUSERS=[ALLUSERS]; MSIINSTALLPERUSER=[MSIINSTALLPERUSER]; INSTALLFOLDER=[INSTALLFOLDER]" Execute="firstSequence" />
    <InstallUISequence>
      <Custom Action="SetPerUserInstallFolder" Before="CostFinalize" Condition="NOT INSTALLFOLDER AND NOT ALLUSERS=1" />
      <Custom Action="SetPerMachineInstallFolder" Before="CostFinalize" Condition="NOT INSTALLFOLDER AND ALLUSERS=1" />
      <Custom Action="SetArpInstallLocation" After="CostFinalize" />
      <Custom Action="SetPerUserDiagnosticContext" After="SetArpInstallLocation" Condition="NOT ALLUSERS=1" />
      <Custom Action="SetPerMachineDiagnosticContext" After="SetArpInstallLocation" Condition="ALLUSERS=1" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="SetPerUserInstallFolder" Before="CostFinalize" Condition="NOT INSTALLFOLDER AND NOT ALLUSERS=1" />
      <Custom Action="SetPerMachineInstallFolder" Before="CostFinalize" Condition="NOT INSTALLFOLDER AND ALLUSERS=1" />
      <Custom Action="SetArpInstallLocation" After="CostFinalize" />
      <Custom Action="SetPerUserDiagnosticContext" After="SetArpInstallLocation" Condition="NOT ALLUSERS=1" />
      <Custom Action="SetPerMachineDiagnosticContext" After="SetArpInstallLocation" Condition="ALLUSERS=1" />
    </InstallExecuteSequence>

    <Property Id="NETFRAMEWORK48FULL">
      <RegistrySearch Id="NetFramework48ReleaseSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
                      Name="Release" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="VSTORUNTIME">
      <RegistrySearch Id="VstoRuntimeSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\VSTO Runtime Setup\v4R"
                      Name="Version" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="VSTORUNTIME32">
      <RegistrySearch Id="VstoRuntime32Search" Root="HKLM"
                      Key="SOFTWARE\Microsoft\VSTO Runtime Setup\v4R"
                      Name="Version" Type="raw" Bitness="always32" />
    </Property>
    <Property Id="OFFICE64PATH">
      <RegistrySearch Id="Office64PathSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Office\16.0\Common\InstallRoot"
                      Name="Path" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="OFFICE64PLATFORM">
      <RegistrySearch Id="OfficeClickToRunPlatformSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Office\ClickToRun\Configuration"
                      Name="Platform" Type="raw" Bitness="always64" />
    </Property>

    <Launch Condition="VersionNT64" Message="!(loc.RequiresWindowsX64)" />
    <Launch Condition="NETFRAMEWORK48FULL &gt;= &quot;#528040&quot;" Message="!(loc.RequiresNet48)" />
    <Launch Condition="VSTORUNTIME OR VSTORUNTIME32" Message="!(loc.RequiresVsto)" />
    <Launch Condition="OFFICE64PATH OR OFFICE64PLATFORM=&quot;x64&quot;" Message="!(loc.RequiresOffice64)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="iWorkHelper">
        <Directory Id="ExcelFolder" Name="Excel" />
        <Directory Id="OutlookFolder" Name="Outlook" />
      </Directory>
    </StandardDirectory>

    <Feature Id="ExcelFeature" Title="!(loc.ExcelFeatureTitle)" Description="!(loc.ExcelFeatureDescription)" Level="1" AllowAbsent="yes">
      <ComponentGroupRef Id="ExcelPayload" />
      <ComponentRef Id="ExcelRegistration" />
    </Feature>
    <Feature Id="OutlookFeature" Title="!(loc.OutlookFeatureTitle)" Description="!(loc.OutlookFeatureDescription)" Level="1" AllowAbsent="yes">
      <ComponentGroupRef Id="OutlookPayload" />
      <ComponentRef Id="OutlookRegistration" />
    </Feature>
  </Package>
</Wix>

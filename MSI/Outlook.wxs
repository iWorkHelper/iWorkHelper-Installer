<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="OutlookLocalPayload" Directory="OutlookLocalFolder">
      <Component Id="OutlookLocalFiles" Guid="{53F6585C-9533-42A2-9FBF-018E75CB6593}" Bitness="always64">
        <File Id="OutlookLocalDll" Source="$(PayloadRoot)\OutlookLocal\oWorkhelper.dll" KeyPath="yes" />
        <File Id="OutlookLocalDllManifest" Source="$(PayloadRoot)\OutlookLocal\oWorkhelper.dll.manifest" />
        <File Id="OutlookLocalVsto" Source="$(PayloadRoot)\OutlookLocal\oWorkhelper.vsto" />
        <File Source="$(PayloadRoot)\OutlookLocal\Microsoft.Office.Tools.Common.v4.0.Utilities.dll" />

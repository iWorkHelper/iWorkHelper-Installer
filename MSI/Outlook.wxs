  <Fragment>
    <Component Id="OutlookLocalRegistration" Directory="OutlookLocalFolder" Guid="{EFCB2A26-84EC-40C9-9562-0B8667C51E3F}" Bitness="always64">
      <RegistryKey Root="HKMU" Key="Software\Microsoft\Office\Outlook\Addins\oWorkhelper">
        <RegistryValue Name="Description" Type="string" Value="!(loc.OutlookAddinDescription)" />
        <RegistryValue Name="FriendlyName" Type="string" Value="oWorkHelper" />
        <RegistryValue Name="LoadBehavior" Type="integer" Value="3" />
        <RegistryValue Name="Manifest" Type="string" Value="file:///[OutlookLocalFolder]oWorkhelper.vsto|vstolocal" KeyPath="yes" />
      </RegistryKey>
      <RegistryValue Root="HKMU" Key="Software\iWorkHelper\Installer" Name="OutlookEdition" Type="string" Value="Local" />
    </Component>

    <Component Id="OutlookLocalOnlineRegistration" Directory="OutlookLocalOnlineFolder" Guid="{AD7B4FB7-BDF2-402E-9923-96C5BC676E6B}" Bitness="always64">
      <RegistryKey Root="HKMU" Key="Software\Microsoft\Office\Outlook\Addins\oWorkhelper">

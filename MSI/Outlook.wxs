        <File Source="$(PayloadRoot)\OutlookLocal\Microsoft.Bcl.HashCode.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\System.Buffers.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\System.Memory.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\System.Numerics.Vectors.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\System.Runtime.CompilerServices.Unsafe.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\UglyToad.PdfPig.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\UglyToad.PdfPig.Core.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\UglyToad.PdfPig.DocumentLayoutAnalysis.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\UglyToad.PdfPig.Fonts.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\UglyToad.PdfPig.Package.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\UglyToad.PdfPig.Tokenization.dll" />
        <File Source="$(PayloadRoot)\OutlookLocal\UglyToad.PdfPig.Tokens.dll" />
      </Component>
    </ComponentGroup>


        <File Id="OutlookLocalOnlineVsto" Source="$(PayloadRoot)\OutlookLocalOnline\oWorkhelper.vsto" />
        <File Source="$(PayloadRoot)\OutlookLocalOnline\Microsoft.Office.Tools.Common.v4.0.Utilities.dll" />
